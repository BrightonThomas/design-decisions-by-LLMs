{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "execution": 3600000
    },
    "servers": {
      "dx": {
        "type": "local",
        "command": ["uv", "run", "--no-sync", "python", "-m", "zest.opencode_dx.mcp_server"],
        "cwd": ".",
        "codemode": false
      }
    }
  }
}
